# Passcode required to add, edit or delete recipes (digits work best on the iPad keypad)
RECIPE_PASSCODE=1234
# Long random string used to sign the unlock cookie: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
# Claude API key for photo and web import (https://platform.claude.com)
ANTHROPIC_API_KEY=
# Optional: where the SQLite file lives (defaults to ./data/recipes.db)
# DATABASE_PATH=./data/recipes.db
